{
  "version": "1.1",
  "sources": [
    "docs/design.md",
    "docs/story-service.md",
    "harness/r4-outputs.md",
    "harness/r5-gates.md",
    "harness/r8 (R8 결정)",
    "2026-10-01 NEIS 학교 선택 결정"
  ],
  "colors": {
    "allowed": [
      "#141414",
      "#262626",
      "#707070",
      "#adadad",
      "#e0e0e0",
      "#f0f0f0",
      "#f3f3f3",
      "#ffffff",
      "#d6246a"
    ],
    "allowed_rgba": [
      {
        "value": "rgba(115,115,115,0.56)",
        "only_in": "badge-overlay"
      }
    ],
    "accent": {
      "value": "#d6246a",
      "only_within": [
        "badge-low-stock",
        "reorder-alert-card"
      ]
    },
    "on_primary": {
      "value": "#ffffff",
      "source": "R4 결정"
    }
  },
  "radius": {
    "allowed": [
      0,
      16,
      24,
      9999
    ],
    "button": 9999
  },
  "typography": {
    "family": "Pretendard",
    "figma_fallback_family": "IBM Plex Sans KR",
    "figma_fallback_source": "Figma 서버 환경에 Pretendard 없음 — 시안 한정 대체, 개발은 Pretendard",
    "weights": [
      300,
      400,
      600,
      700
    ],
    "sizes": [
      12,
      13,
      15,
      17,
      18,
      20,
      24,
      28,
      32
    ],
    "letter_spacing": 0,
    "text_case": [
      "ORIGINAL"
    ],
    "text_case_source": "R4 결정"
  },
  "effects": {
    "drop_shadow_max": 0,
    "exceptions": [
      "segmented-control-active"
    ],
    "source": "R4 결정"
  },
  "spacing": {
    "allowed": [
      0,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "button": {
    "name_prefix": "button-",
    "min_height": 44
  },
  "frames": {
    "mobile": [
      390,
      844
    ],
    "desktop": [
      1440,
      900
    ],
    "name_pattern": "^[1-6]-(mobile|desktop)$",
    "keyscreens": {
      "default": [
        2,
        3,
        6
      ],
      "count": [
        2,
        3
      ]
    }
  },
  "s1": {
    "refs_per_screen": [
      3,
      5
    ]
  },
  "roles": {
    "R1": {
      "role": "학생",
      "component": "manual-upload",
      "max": 0
    },
    "R2": {
      "role": "학생",
      "components": [
        "reorder-alert-card",
        "vendor-link"
      ],
      "max": 0
    },
    "R3": {
      "component": "vendor-register",
      "only_roles": [
        "admin"
      ]
    },
    "R4": {
      "component": "msds-entry",
      "min_per_role": 1,
      "roles": [
        "학생",
        "교사",
        "admin"
      ]
    }
  },
  "never": {
    "N1": {
      "school_name_from": "input.json#school_name",
      "screens_require_school_name": [
        2,
        3,
        4,
        5,
        6
      ],
      "school_name_pattern": "[가-힣A-Za-z0-9]+고등학교",
      "distinct_school_names": 1,
      "school_select_only_on": [
        1
      ],
      "school_name_pattern_source": "R8 수정: '…고'는 '재고' 등과 오탐",
      "school_name_scope_screens": [
        2,
        3,
        4,
        5,
        6
      ],
      "school_name_scope_source": "2026-10-01 NEIS: 화면 1 학교 목록에는 여러 학교명이 정상",
      "school_select_levels": [
        "school-select-sido",
        "school-select-region",
        "school-select-school"
      ],
      "school_select_levels_source": "docs/story-service.md 결정 사항 \"학교 선택\""
    },
    "N2": {
      "banned_terms": [
        "API 키",
        "API key",
        "apiKey",
        "Gemini 키",
        "토큰",
        "NEIS 키",
        "나이스 키",
        "인증키"
      ],
      "scan": [
        "frames",
        "spec/s2-spec.md"
      ],
      "screen5_input_label_banned": [
        "키",
        "모델",
        "model"
      ],
      "key_value_pattern": "(?<![0-9A-Fa-f])[0-9A-Fa-f]{32}(?![0-9A-Fa-f])",
      "key_value_pattern_source": "NEIS 인증키 형식(32자리 16진수) — 키 값 자체는 .env에만 둔다"
    }
  },
  "retries": {
    "S1": 2,
    "S2": 2,
    "S3": 3,
    "S5": 3
  },
  "files": {
    "allowed": [
      "input.json",
      "state.json",
      "neis.json",
      "approval.md",
      "research/s1-references.md",
      "research/s1-adopt.md",
      "spec/s2-spec.md",
      "design/s3-keyscreens.json",
      "design/s4-frames.json",
      "judge/gate-S1.json",
      "judge/gate-S2.json",
      "judge/gate-S3.json",
      "judge/gate-S5.json"
    ],
    "source": "R4 산출물 목록, R8 F1"
  },
  "hash_scope": {
    "include": [
      "docs",
      "harness"
    ],
    "exclude": [
      "harness/tests"
    ],
    "exclude_names": [
      "__pycache__"
    ],
    "source": "R8 F2"
  },
  "neis": {
    "endpoint": "https://open.neis.go.kr/hub/schoolInfo",
    "key_env": "NEIS_API_KEY",
    "key_file": ".env",
    "school_kind": "고등학교",
    "sido_field": "LCTN_SC_NM",
    "region_from": "ORG_RDNMA 두 번째 토큰 (시/군/구로 끝날 때만, 아니면 시/도 이름)",
    "default_sido": "충청북도",
    "default_region": "청주시",
    "output": "neis.json",
    "source": "2026-10-01 사용자 결정",
    "exclude_sido": [
      "재외한국학교"
    ],
    "exclude_sido_source": "2026-10-01 사용자 결정 (그 외 시/도 이름은 NEIS 값 그대로)"
  }
}